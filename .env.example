# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these come from repository Secrets and Variables instead.

# Key for the model provider set in config.yaml (llm_provider). Only that one is needed.
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Claude (paid, billed separately from a Claude.ai subscription): https://platform.claude.com
ANTHROPIC_API_KEY=

# Your LinkedIn developer app, used only by scripts/linkedin_auth.py on your own computer.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Printed by scripts/linkedin_auth.py. Only needed locally for a real (non-dry) run.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_ON=
